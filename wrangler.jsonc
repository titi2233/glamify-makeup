{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glamify-makeup",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "http://localhost:3000",
  },
  "observability": {
    "enabled": true,
  },
}
