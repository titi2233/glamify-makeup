# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma)
DATABASE_URL=
DIRECT_URL=

# Mercado Pago (M2)
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Secret del webhook (dashboard MP → Webhooks → clave secreta). Verifica x-signature.
MP_WEBHOOK_SECRET=

# URL pública de la app (para back_urls/notification_url de MP y redirects de auth).
# Local: http://localhost:3000 (el webhook real necesita túnel/preview; ver scripts/simulate-mp-webhook.ts).
# Prod (wrangler.jsonc): https://glamifymakeup.site — DEBE coincidir con el "Site URL"
# y la allow-list de "Redirect URLs" del dashboard de Supabase (Auth → URL Configuration),
# o los links de confirmación de email caen al Site URL (p. ej. localhost). Ver SETUP.md.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Login con Google: solo "true" si el provider Google está habilitado en Supabase
# (Auth → Providers). Por defecto oculto → login por email/password sin botón roto.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# Resend (M2/M5) — sin key, los emails se loguean a consola en dev.
RESEND_API_KEY=
RESEND_FROM="Glamify Makeup <pedidos@glamifymakeup.site>"
RESEND_OWNER_EMAIL=

# MiCorreo / Correo Argentino (diferido a M5; sin estas vars → fallback a zonas)
MICORREO_USER=
MICORREO_PASSWORD=
MICORREO_AGREEMENT=

# PostHog (M4b — analytics/conversión). Sin key → analytics desactivado (dev local intacto).
# Crear proyecto free en posthog.com y copiar Project API Key + host (us/eu).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Exit-intent: código del cupón de bienvenida a revelar (debe existir y estar activo; el seed crea BIENVENIDA10).
# Vacío → el exit-intent solo captura email, sin revelar código.
NEXT_PUBLIC_WELCOME_COUPON_CODE=BIENVENIDA10

# Scripts / E2E (no son secrets de la app; los usan admin:create / customer:create y Playwright)
ADMIN_EMAIL=
ADMIN_PASSWORD=
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
